# Copy to .env for local overrides and run:  node --env-file=.env server.js
# On Render these are set in render.yaml / the dashboard. Never commit a real .env.

# Port to bind. Render injects PORT automatically; locally the default is 5000.
PORT=5000

# HMAC secret for challenge/reward tokens. REQUIRED in production so tokens stay
# valid across restarts (free instances sleep and restart). Any long random string.
GAME_SECRET=change-me-to-a-long-random-string

# Frontend origins allowed by CORS (comma-separated, no trailing slash).
ALLOWED_ORIGINS=https://math3d-web.onrender.com

# localhost / LAN origins are allowed by default (handy for local dev against
# the production API). Set to "false" to lock the API to ALLOWED_ORIGINS only.
ALLOW_LOCAL_ORIGINS=true

NODE_ENV=development
